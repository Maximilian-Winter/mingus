// Stress Test 20: Reentrant Closure Storm
// Simulates a callback that recursively schedules another closure,
// mimicking event-loop style "concurrency". If retain/release ordering
// is wrong, you get use-after-free or leaks.

module Stress20
{
    extern func puts(string s) => int;
    extern func printf(string fmt, int val) => int;

    func schedule((int) => int f, int depth) => int
    {
        if (depth == 0)
        {
            return f(1);
        }

        var next = (int x) => {
            return f(x) + 1;
        };

        return schedule(next, depth - 1);
    }

    func make(int base) => (int) => int
    {
        return (int x) => { return x + base; };
    }

    func main() => int
    {
        for (int i = 0; i < 20000; i++)
        {
            var f = make(i % 10);
            var r = schedule(f, 5);
        }

        puts("Stress20 done");
        return 0;
    }
}
