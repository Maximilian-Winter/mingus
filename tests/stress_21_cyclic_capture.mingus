// Stress Test 21: Cyclic Capture Probe
// ARC's classic enemy is reference cycles. This test creates heap objects
// with closure fields, assigns non-capturing closures, and deletes them.
// Currently no actual cycle (closure doesn't capture `n`).
// Future: when self-capturing closures work, this becomes the cycle test.
//
// NOTE: No explicit constructor or destructor — compiler auto-generates them.
// This verifies that auto-generated ctor zero-inits closure fields and
// auto-generated dtor releases them correctly.

module Stress21
{
    extern func puts(string s) => int;

    class Node
    {
        (int) => int fn;
    }

    func makeIncrement() => (int) => int
    {
        return (int x) => { return x + 1; };
    }

    func main() => int
    {
        for (int i = 0; i < 10000; i++)
        {
            var n = new Node();
            n->fn = makeIncrement();
            delete n;
        }

        puts("Stress21 done");
        return 0;
    }
}
