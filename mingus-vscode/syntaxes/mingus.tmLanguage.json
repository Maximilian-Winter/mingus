{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mingus",
  "scopeName": "source.mingus",
  "fileTypes": ["mingus"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#storage-types" },
    { "include": "#storage-modifiers" },
    { "include": "#control-flow" },
    { "include": "#memory-keywords" },
    { "include": "#module-keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mingus",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mingus",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "comment.block.mingus",
              "match": "."
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mingus",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mingus",
              "match": "\\\\[nrtfb0'\\\\]"
            },
            {
              "name": "constant.other.placeholder.mingus",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#expression-content" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.mingus",
          "match": "'([^'\\\\]|\\\\[nrtfb0'\\\\])'",
          "captures": {
            "0": { "name": "constant.character.mingus" }
          }
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.mingus",
      "match": "@([a-zA-Z_][a-zA-Z0-9_]*)(?:\\((\\d+)\\))?",
      "captures": {
        "1": { "name": "entity.name.function.decorator.mingus" },
        "2": { "name": "constant.numeric.mingus" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.mingus",
          "match": "\\b(module|class|struct|union|tagged|enum|func|constructor|destructor|operator|interface|typedef|extern|opaque)\\b"
        },
        {
          "name": "keyword.other.mingus",
          "match": "\\b(this|super|raw|link|import|from|as|sizeof|alignof)\\b"
        }
      ]
    },
    "storage-types": {
      "name": "storage.type.mingus",
      "match": "\\b(int|double|float|byte|string|char|bool|void|short|ushort|uint|long|ulong|var)\\b"
    },
    "storage-modifiers": {
      "name": "storage.modifier.mingus",
      "match": "\\b(public|private|protected|static|abstract|const|shared|weak)\\b"
    },
    "control-flow": {
      "name": "keyword.control.mingus",
      "match": "\\b(if|else|switch|case|default|match|for|while|do|return|break|continue)\\b"
    },
    "memory-keywords": {
      "name": "keyword.other.memory.mingus",
      "match": "\\b(new|delete|null|move)\\b"
    },
    "module-keywords": {
      "name": "keyword.control.import.mingus",
      "match": "\\b(import|from|as)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.mingus",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.mingus",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.mingus",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.mingus",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.float.mingus",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?[fF]?\\b"
        },
        {
          "name": "constant.numeric.float.mingus",
          "match": "\\b\\d+[eE][+-]?\\d+[fF]?\\b"
        },
        {
          "name": "constant.numeric.decimal.mingus",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.mingus",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.mingus",
          "match": "=>|->|::<"
        },
        {
          "name": "keyword.operator.range.mingus",
          "match": "\\.\\.|\\.\\.\\."
        },
        {
          "name": "keyword.operator.assignment.compound.mingus",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.comparison.mingus",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.mingus",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.mingus",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.mingus",
          "match": "\\+\\+|--|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.mingus",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.mingus",
          "match": "\\b(func|constructor|destructor|operator)\\s+([a-zA-Z_][a-zA-Z0-9_]*|\\+|-|\\*|/|%|==|!=|<|>|<=|>=|\\[\\])",
          "captures": {
            "1": { "name": "storage.type.function.mingus" },
            "2": { "name": "entity.name.function.mingus" }
          }
        },
        {
          "name": "support.function.builtin.mingus",
          "match": "\\b(printf|puts|malloc|free|sizeof|alignof)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "meta.type.declaration.mingus",
          "match": "\\b(class|struct|enum|interface|union|tagged)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.mingus" },
            "2": { "name": "entity.name.type.mingus" }
          }
        },
        {
          "name": "entity.name.type.mingus",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.mingus",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.section.block.mingus",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.mingus",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.mingus",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.accessor.mingus",
          "match": "\\.|->|::"
        }
      ]
    },
    "expression-content": {
      "patterns": [
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#numbers" },
        { "include": "#storage-types" }
      ]
    }
  }
}