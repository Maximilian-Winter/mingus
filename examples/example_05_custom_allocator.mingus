// example_05_custom_allocator.mingus
// Memory pool allocator with RAII guards
// Features: raw blocks, pointer arithmetic, RAII, destructors, closures, higher-order functions

module CustomAllocator
{
    extern func printf(string fmt, int val) => int;
    extern func puts(string s) => int;
    extern func malloc(int size) => byte*;
    extern func free(byte* ptr) => void;
    extern func memset(byte* ptr, int value, int n) => byte*;
    extern func memcpy(byte* dest, byte* src, int n) => byte*;

    class PoolAllocator
    {
        byte* memory;
        int capacity;
        int used;
        int blockSize;

        constructor(int numBlocks, int blkSize)
        {
            this.blockSize = blkSize;
            this.capacity = numBlocks * blkSize;
            this.used = 0;
            raw {
                this.memory = malloc(this.capacity);
                memset(this.memory, 0, this.capacity);
            }
            printf("Pool created: %d", this.capacity);
            puts(" bytes");
        }

        destructor
        {
            raw { free(this.memory); }
            puts("Pool destroyed");
        }

        func allocate() => byte*
        {
            if (this.used + this.blockSize > this.capacity)
            {
                return null;  // Out of memory
            }
            raw {
                var ptr = this.memory + this.used;
                this.used = this.used + this.blockSize;
                return ptr;
            }
        }

        func reset() => void
        {
            this.used = 0;
            raw { memset(this.memory, 0, this.capacity); }
        }

        func usage() => int
        {
            return (this.used * 100) / this.capacity;
        }
    }

    // RAII guard for automatic pool reset on scope exit
    class PoolScope
    {
        PoolAllocator* pool;
        bool shouldReset;

        constructor(PoolAllocator* p, bool autoReset)
        {
            this.pool = p;
            this.shouldReset = autoReset;
            puts("  [Scope enter]");
        }

        destructor
        {
            if (this.shouldReset)
            {
                puts("  [Scope exit - auto reset]");
                this.pool->reset();
            }
            else
            {
                puts("  [Scope exit - preserving]");
            }
        }
    }

    struct Particle
    {
        int x;
        int y;
        int vx;
        int vy;
    }

    func particleSystemDemo() => void
    {
        puts("\n--- Particle System Demo ---");

        // Create a pool for 100 particles (16 bytes each)
        var pool = PoolAllocator(100, 16);

        {
            // Scope with automatic reset
            var scope = PoolScope(&pool, true);

            // Allocate particles
            for (int i = 0; i < 5; i++)
            {
                raw {
                    var p = (Particle*)pool.allocate();
                    if (p != null) {
                        p->x = i * 10;
                        p->y = i * 20;
                        p->vx = 1;
                        p->vy = -1;
                    }
                }
            }

            printf("Pool usage: %d", pool.usage());
            puts("%");
        }
        // Pool auto-reset here

        printf("After reset: %d", pool.usage());
        puts("%");

        // Allocate again to prove reuse
        raw {
            var p = (Particle*)pool.allocate();
            if (p != null) {
                p->x = 999;
            }
        }
        printf("After new alloc: %d", pool.usage());
        puts("%");
    }

    func closurePoolDemo() => void
    {
        puts("\n--- Closure + Pool Demo ---");

        var pool = PoolAllocator(10, 8);

        // Capture a POINTER to the pool — the pointer value is copied
        // into the closure env, but it still references the original pool
        var poolPtr = &pool;
        var allocBlock = [=]() => {
            var ptr = poolPtr->allocate();
            return ptr == null ? 0 : 1;
        };

        // Allocate through closure until pool is full
        var allocated = 0;
        for (int i = 0; i < 12; i++)
        {
            if (allocBlock() == 1)
            {
                allocated = allocated + 1;
            }
            else
            {
                printf("  Pool full after %d blocks\n", allocated);
                break;
            }
        }

        printf("Final pool usage: %d", pool.usage());
        puts("%");
    }

    // Higher-order function: applies a transform N times
    func applyN(int n, (int) => int f, int start) => int
    {
        var result = start;
        for (int i = 0; i < n; i++)
        {
            result = f(result);
        }
        return result;
    }

    func higherOrderDemo() => void
    {
        puts("\n--- Higher-Order Function Demo ---");

        // Closure as function argument
        var doubled = applyN(5, [](int x) => { return x * 2; }, 1);
        printf("2^5 via repeated doubling: %d\n", doubled);

        // Closure capturing a multiplier
        var factor = 3;
        var tripled = applyN(4, [=](int x) => { return x * factor; }, 1);
        printf("3^4 via repeated tripling: %d\n", tripled);
    }

    func main() => int
    {
        puts("=== Custom Allocator Demo ===");

        particleSystemDemo();
        closurePoolDemo();
        higherOrderDemo();

        puts("\n=== Allocator demo complete ===");
        return 0;
    }
}
