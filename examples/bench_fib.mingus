module BenchFib
{
    extern func printf(string fmt, ...) => int;

    func FindFibonacciNumber(int n) => int
    {
        var count = 2;
        var a = 1;
        var b = 1;
        var c = 1;
        if (n == 0)
        {
            return 0;
        }
        while (count < n)
        {
            c = a + b;
            a = b;
            b = c;
            count++;
        }
        return c;
    }

    func main() => int
    {
        var temp = 0;
        var count3 = 0;
        while (count3 < 1000)
        {
            var count2 = 0;
            while (count2 < 37)
            {
                temp = FindFibonacciNumber(count2);
                count2++;
            }
            count3++;
        }
        printf("%d\n", temp);
        return 0;
    }
}
