// example_01_audio_effects.mingus
// A tribute to Charles Mingus - modular audio effects processor
// Features: structs, operator overloading, closures, pipes, enums

module AudioEffects
{
    extern func printf(string fmt, ...) => int;
    extern func puts(string s) => int;
    extern func sin(double x) => double;

    enum Waveform : int
    {
        Sine = 0,
        Triangle = 1,
        Saw = 2,
        Square = 3,
    }

    struct Sample
    {
        double left;
        double right;

        func operator+(Sample other) => Sample
        {
            Sample out;
            out.left = this.left + other.left;
            out.right = this.right + other.right;
            return out;
        }

        func operator*(double gain) => Sample
        {
            Sample out;
            out.left = this.left * gain;
            out.right = this.right * gain;
            return out;
        }
    }

    func oscillator(int wave, double phase) => double
    {
        // Sine wave
        if (wave == Waveform.Sine)
        {
            return sin(phase * 6.283185307);
        }
        // Square wave
        if (wave == Waveform.Square)
        {
            return phase < 0.5 ? 1.0 : -1.0;
        }
        // Triangle wave
        if (wave == Waveform.Triangle)
        {
            return phase < 0.5 ? phase * 4.0 - 1.0 : 3.0 - phase * 4.0;
        }
        // Saw wave (default)
        return phase * 2.0 - 1.0;
    }

    func makeDelay(double feedback) => (Sample) => Sample
    {
        var prevLeft = 0.0;
        var prevRight = 0.0;

        return [=](Sample input) => {
            var outLeft = input.left + prevLeft * feedback;
            var outRight = input.right + prevRight * feedback;
            prevLeft = outLeft;
            prevRight = outRight;
            Sample out;
            out.left = outLeft;
            out.right = outRight;
            return out;
        };
    }

    func processSignal(Sample input, (Sample) => Sample effect) => Sample
    {
        return input |> effect;
    }

    func main() => int
    {
        puts("=== Mingus Audio Effects ===");

        // Create a bass tone (like Charles Mingus would play)
        var bass = Sample();
        bass.left = oscillator(Waveform.Saw, 0.15);   // ~65Hz
        bass.right = bass.left;
        printf("Bass raw: L=%.3f", bass.left);
        printf(" R=%.3f\n", bass.right);

        // Chain effects using closures and pipes
        var delay = makeDelay(0.5);
        var boosted = bass * 2.0;
        var distorted = boosted |> delay;

        printf("After effects: L=%.3f", distorted.left);
        printf(" R=%.3f\n", distorted.right);

        // Layer multiple waveforms
        var mix = Sample();
        for (int i = 0; i < 4; i++)
        {
            var osc = Sample();
            osc.left = oscillator(i, 0.25 + i * 0.1);
            osc.right = osc.left;
            mix = mix + osc * 0.25;
        }

        printf("Mixed oscillators: L=%.3f\n", mix.left);
        puts("=== Audio chain complete ===");
        return 0;
    }
}
