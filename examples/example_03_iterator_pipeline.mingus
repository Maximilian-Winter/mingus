// example_03_iterator_pipeline.mingus
// Lazy evaluation pipeline for data transformation
// Features: classes, closures, tuples, higher-order functions, RAII in loops

module IteratorPipeline
{
    extern func printf(string fmt, ...) => int;
    extern func puts(string s) => int;

    class Counter
    {
        int current;
        int limit;
        constructor(int start, int end)
        {
            this.current = start;
            this.limit = end;
        }
        func next() => int
        {
            var val = this.current;
            this.current = this.current + 1;
            return val;
        }
        func hasNext() => bool
        {
            return this.current < this.limit;
        }
    }

    // Filter: even numbers only
    class EvenCounter
    {
        Counter* source;
        int buffered;
        bool hasBuffer;
        constructor(Counter* src)
        {
            this.source = src;
            this.hasBuffer = false;
        }
        destructor
        {
            delete this.source;
        }
        func advance() => void
        {
            while (this.source->hasNext())
            {
                var val = this.source->next();
                if (val % 2 == 0)
                {
                    this.buffered = val;
                    this.hasBuffer = true;
                    return;
                }
            }
            this.hasBuffer = false;
        }
        func next() => int
        {
            if (!this.hasBuffer) { this.advance(); }
            this.hasBuffer = false;
            return this.buffered;
        }
        func hasNext() => bool
        {
            if (!this.hasBuffer) { this.advance(); }
            return this.hasBuffer;
        }
    }

    // Map: transform using closure
    class MapCounter
    {
        Counter* source;
        (int) => int transform;
        constructor(Counter* src, (int) => int fn)
        {
            this.source = src;
            this.transform = fn;
        }
        destructor
        {
            delete this.source;
        }
        func next() => int
        {
            return this.transform(this.source->next());
        }
        func hasNext() => bool
        {
            return this.source->hasNext();
        }
    }

    func main() => int
    {
        puts("=== Iterator Pipeline ===");

        // Simple counter 1..10
        puts("Simple counter 1..10:");
        var counter = new Counter(1, 10);
        var sum1 = 0;
        var count1 = 0;
        while (counter->hasNext())
        {
            sum1 = sum1 + counter->next();
            count1 = count1 + 1;
        }
        delete counter;
        printf("Sum=%d", sum1);
        printf(" Count=%d\n", count1);

        // Filter: even numbers only 1..20
        puts("\nEven numbers 1..20:");
        var evenIter = new EvenCounter(new Counter(1, 20));
        var sum2 = 0;
        var count2 = 0;
        while (evenIter->hasNext())
        {
            sum2 = sum2 + evenIter->next();
            count2 = count2 + 1;
        }
        delete evenIter;
        printf("Sum=%d", sum2);
        printf(" Count=%d\n", count2);

        // Map: transform each element (x * 3 + 1) for 1..10
        puts("\nMap (x * 3 + 1) for 1..10:");
        var mapped = new MapCounter(
            new Counter(1, 10),
            [](int x) => { return x * 3 + 1; }
        );
        var sum3 = 0;
        var count3 = 0;
        while (mapped->hasNext())
        {
            sum3 = sum3 + mapped->next();
            count3 = count3 + 1;
        }
        delete mapped;
        printf("Sum=%d", sum3);
        printf(" Count=%d\n", count3);

        // Odd numbers squared
        puts("\nOdd numbers squared (1..10):");
        var manualSum = 0;
        for (int i = 1; i <= 10; i = i + 2)
        {
            manualSum = manualSum + (i * i);
        }
        printf("Sum of odd squares: %d\n", manualSum);

        puts("=== Pipeline complete ===");
        return 0;
    }
}
