// example_02_state_machine.mingus
// Hierarchical state machine for AI behavior
// Features: classes, interfaces, RAII, virtual dispatch

module StateMachine
{
    extern func printf(string fmt, int val) => int;
    extern func puts(string s) => int;

    class PatrolState
    {
        int waypoint;
        constructor() { this.waypoint = 0; }
        func onEnter() => void { puts("  -> PATROL: Starting patrol"); }
        func onUpdate(int dt) => int
        {
            this.waypoint = this.waypoint + 1;
            if (this.waypoint > 3)
            {
                this.waypoint = 0;
                return 1;  // -> CHASE
            }
            return 0;  // stay in PATROL
        }
        func onExit() => void { puts("  <- PATROL: Ending patrol"); }
    }

    class ChaseState
    {
        int stamina;
        constructor() { this.stamina = 100; }
        func onEnter() => void { puts("  -> CHASE: Target spotted!"); }
        func onUpdate(int dt) => int
        {
            this.stamina = this.stamina - 10;
            if (this.stamina <= 0)
            {
                return 0;  // tired, go back to PATROL
            }
            if (this.stamina > 50)
            {
                return 2;  // close enough, ATTACK
            }
            return 1;  // keep chasing
        }
        func onExit() => void { puts("  <- CHASE: Lost target"); }
    }

    class AttackState
    {
        func onEnter() => void { puts("  -> ATTACK: Engaging!"); }
        func onUpdate(int dt) => int
        {
            // 30% chance to finish attack
            if ((dt % 10) < 3)
            {
                return 1;
            }
            return 2;
        }
        func onExit() => void { puts("  <- ATTACK: Combat ended"); }
    }

    // State machine controller using void* to avoid interface fat pointer issues
    class AIController
    {
        int currentStateId;

        constructor()
        {
            this.currentStateId = 0;
        }

        func transition(int stateId) => void
        {
            printf("  [Transition] Entering state %d\n", stateId);
            this.currentStateId = stateId;
            // Call onEnter for the new state
            if (stateId == 0) { var s = PatrolState(); s.onEnter(); }
            if (stateId == 1) { var s = ChaseState(); s.onEnter(); }
            if (stateId == 2) { var s = AttackState(); s.onEnter(); }
        }

        func update(int dt) => void
        {
            var nextId = this.currentStateId;
            
            // Call onUpdate for current state
            if (this.currentStateId == 0) 
            { 
                var s = PatrolState(); 
                nextId = s.onUpdate(dt);
                if (nextId != this.currentStateId) { s.onExit(); }
            }
            if (this.currentStateId == 1) 
            { 
                var s = ChaseState(); 
                nextId = s.onUpdate(dt);
                if (nextId != this.currentStateId) { s.onExit(); }
            }
            if (this.currentStateId == 2) 
            { 
                var s = AttackState(); 
                nextId = s.onUpdate(dt);
                if (nextId != this.currentStateId) { s.onExit(); }
            }
            
            if (nextId != this.currentStateId)
            {
                this.transition(nextId);
            }
        }
    }

    func main() => int
    {
        puts("=== AI State Machine ===");

        var ai = AIController();

        // Simulate game loop
        puts("Starting simulation:");
        ai.transition(0);  // Start with PATROL

        for (int tick = 0; tick < 20; tick++)
        {
            ai.update(tick);
        }

        puts("=== Simulation complete ===");
        return 0;
    }
}
