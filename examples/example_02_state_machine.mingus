// example_02_state_machine.mingus
// Hierarchical state machine for AI behavior
// Features: classes, heap allocation (new/delete), RAII, pointer fields, else-if chains

module StateMachine
{
    extern func printf(string fmt, int val) => int;
    extern func puts(string s) => int;

    class PatrolState
    {
        int waypoint;
        constructor() { this.waypoint = 0; }
        func onEnter() => void
        {
            this.waypoint = 0;
            puts("  -> PATROL: Starting patrol");
        }
        func onUpdate(int dt) => int
        {
            this.waypoint = this.waypoint + 1;
            printf("     Patrol waypoint %d\n", this.waypoint);
            if (this.waypoint >= 3)
            {
                return 1;  // -> CHASE
            }
            return 0;  // stay in PATROL
        }
        func onExit() => void { puts("  <- PATROL: Ending patrol"); }
    }

    class ChaseState
    {
        int stamina;
        constructor() { this.stamina = 50; }
        func onEnter() => void
        {
            this.stamina = 50;
            puts("  -> CHASE: Target spotted!");
        }
        func onUpdate(int dt) => int
        {
            this.stamina = this.stamina - 10;
            printf("     Chase stamina=%d\n", this.stamina);
            if (this.stamina <= 0)
            {
                return 0;  // tired -> PATROL
            }
            if (this.stamina <= 20)
            {
                return 2;  // close enough -> ATTACK
            }
            return 1;  // keep chasing
        }
        func onExit() => void { puts("  <- CHASE: Disengaging"); }
    }

    class AttackState
    {
        int attacks;
        constructor() { this.attacks = 0; }
        func onEnter() => void
        {
            this.attacks = 0;
            puts("  -> ATTACK: Engaging!");
        }
        func onUpdate(int dt) => int
        {
            this.attacks = this.attacks + 1;
            printf("     Attack #%d\n", this.attacks);
            if (this.attacks >= 2)
            {
                return 0;  // done attacking -> PATROL
            }
            return 2;  // keep attacking
        }
        func onExit() => void { puts("  <- ATTACK: Combat ended"); }
    }

    // State machine controller — owns persistent state objects via pointers
    class AIController
    {
        PatrolState* patrol;
        ChaseState* chase;
        AttackState* attack;
        int currentStateId;

        constructor()
        {
            this.patrol = new PatrolState();
            this.chase = new ChaseState();
            this.attack = new AttackState();
            this.currentStateId = 0;
        }

        destructor
        {
            delete this.patrol;
            delete this.chase;
            delete this.attack;
        }

        func enterState(int stateId) => void
        {
            this.currentStateId = stateId;
            if (stateId == 0) { this.patrol->onEnter(); }
            if (stateId == 1) { this.chase->onEnter(); }
            if (stateId == 2) { this.attack->onEnter(); }
        }

        func update(int dt) => void
        {
            var nextId = this.currentStateId;

            if (this.currentStateId == 0)
            {
                nextId = this.patrol->onUpdate(dt);
                if (nextId != 0) { this.patrol->onExit(); }
            }
            else if (this.currentStateId == 1)
            {
                nextId = this.chase->onUpdate(dt);
                if (nextId != 1) { this.chase->onExit(); }
            }
            else if (this.currentStateId == 2)
            {
                nextId = this.attack->onUpdate(dt);
                if (nextId != 2) { this.attack->onExit(); }
            }

            if (nextId != this.currentStateId)
            {
                this.enterState(nextId);
            }
        }
    }

    func main() => int
    {
        puts("=== AI State Machine ===");

        var ai = AIController();
        puts("Starting simulation:");
        ai.enterState(0);

        for (int tick = 0; tick < 15; tick++)
        {
            printf("[Tick %d]\n", tick);
            ai.update(tick);
        }

        puts("=== Simulation complete ===");
        return 0;
    }
}
